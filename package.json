{
  "name": "fcrww-matrix-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "maint:update": "ncu -u -t minor && npm install && npm audit fix && npm install",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run build",
    "security:check": "node scripts/check-public-repo.mjs"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.8.0",
    "emoji-picker-react": "^4.22.2",
    "matrix-js-sdk": "^42.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
