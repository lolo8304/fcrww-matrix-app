# Public, build-time browser configuration. NEVER put credentials or keys here.
# Replace these examples with your own homeserver and Matrix domain.
# Optional: defaults to local for dev, prod for builds, preview for --mode preview.
# STAGE=local
# Optional extra space/room filters (comma-separated globs, '*' wildcard).
# Use <space-pattern>.<room-pattern>, e.g. *.B; no dot means all rooms.
# Escape literal dots in space names as \.
# Independent of STAGE. Exclusion wins. Empty means no restriction.
VITE_MATRIX_SPACE_INCLUDE=
VITE_MATRIX_SPACE_EXCLUDE=
VITE_MATRIX_BASE_URL=https://matrix.example.org
VITE_MATRIX_SERVER_NAME=example.org
VITE_MATRIX_DISCOVERY_ORIGIN=https://example.org
